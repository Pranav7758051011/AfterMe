{
  "name": "afterme-monorepo",
  "version": "1.0.0",
  "description": "AfterMe — Proactive AI Memory Assistant with Context-Grounded Retrieval and Spatial Geofencing",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "build": "npm --prefix backend run build && npm --prefix apps/web run build",
    "backend": "npm --prefix backend run dev",
    "web": "npm --prefix apps/web run dev",
    "mobile": "npm --prefix apps/mobile start",
    "test": "node scripts/run-all-tests.js",
    "test:ai": "node tests/ai-validation.test.js",
    "test:gps": "node tests/gps-reliability.test.js",
    "test:alerts": "node tests/alert-protection.test.js",
    "test:security": "node tests/security-isolation.test.js",
    "test:resilience": "node tests/resilience-fallback.test.js",
    "test:metrics": "node tests/metrics-observability.test.js",
    "test:benchmark": "node scripts/benchmark-evaluation.js",
    "test:e2e": "node tests/full-demo.test.js",
    "generate:icons": "node scripts/generate-pwa-icons.js",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:firestore": "firebase deploy --only firestore"
  },
  "keywords": [
    "gemini",
    "ai-memory",
    "proactive-assistant",
    "firebase",
    "geofence",
    "typescript",
    "react"
  ],
  "author": "AfterMe Team",
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.35.4"
  }
}
