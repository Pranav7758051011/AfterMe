{
  "name": "afterme-monorepo",
  "version": "1.0.0",
  "description": "AfterMe — Proactive AI Memory Assistant",
  "private": true,
  "scripts": {
    "dev": "node start-dev.js",
    "build": "npm --prefix backend run build && npm --prefix apps/web run build",
    "backend": "npm --prefix backend run dev",
    "web": "npm --prefix apps/web run dev",
    "mobile": "npm --prefix apps/mobile start",
    "test": "node test-all.js",
    "test:ai": "node test-ai-validation.js",
    "test:gps": "node test-gps-reliability.js",
    "test:alerts": "node test-alert-protection.js",
    "test:security": "node test-security-isolation.js",
    "test:resilience": "node test-resilience-fallback.js",
    "test:metrics": "node test-metrics-observability.js",
    "test:benchmark": "node benchmark-evaluation.js",
    "test:e2e": "node test-full-demo.js",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:firestore": "firebase deploy --only firestore"
  },
  "keywords": [
    "gemini",
    "ai-memory",
    "proactive-assistant",
    "firebase"
  ],
  "author": "AfterMe Team",
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.35.4"
  }
}
