rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid
      );
    }

    function isCreatingOwnDoc() {
      return isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid
      );
    }

    // User Profile Documents
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Memories Collection (Strict User Isolation)
    match /memories/{memoryId} {
      allow read: if isDocOwner();
      allow create: if isCreatingOwnDoc();
      allow update, delete: if isDocOwner();
    }

    // Proactive Alerts Collection
    match /alerts/{alertId} {
      allow read: if isDocOwner();
      allow create: if isCreatingOwnDoc();
      allow update, delete: if isDocOwner();
    }

    // User Location & Real-Time Context State
    match /user_state/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
