# ========================================================
# AFTERME — UNIFIED ENVIRONMENT CONFIGURATION
# ========================================================

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# 🧠 Google Gemini API (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 🔥 Firebase Admin SDK (Server / Cloud Functions)
# Option A: Explicit Credentials
FIREBASE_PROJECT_ID=afterme-ai-app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Option B: Path to Service Account JSON
GOOGLE_APPLICATION_CREDENTIALS=

# 🌐 Firebase Client Configuration (Web & Mobile Apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=afterme-ai-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=afterme-ai-app
VITE_FIREBASE_STORAGE_BUCKET=afterme-ai-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 📱 Mobile API URL
EXPO_PUBLIC_API_URL=http://localhost:3001
